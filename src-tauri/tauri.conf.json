{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MD Flow Viewer",
  "version": "3.0.0",
  "identifier": "com.cafercan.mdflowviewer",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MD Flow Viewer",
        "width": 1280,
        "height": 860,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
