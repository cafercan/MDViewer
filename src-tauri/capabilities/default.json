{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Ana pencere: yalnız uygulamanın kendi komutları ve gereken çekirdek izinler",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy",
    "core:app:allow-register-listener",
    "allow-content",
    "allow-save",
    "allow-get-settings",
    "allow-set-settings",
    "allow-open-file",
    "allow-open-file-path",
    "allow-open-folder",
    "allow-open-folder-path",
    "allow-recent-list",
    "allow-clear-recent-list",
    "allow-explorer-state",
    "allow-list-dir",
    "allow-explorer-up",
    "allow-explorer-enter",
    "allow-set-vault",
    "allow-resolve-wikilink",
    "allow-inspect-path",
    "allow-list-notes",
    "allow-create-note",
    "allow-print-page",
    "allow-open-external",
    "allow-open-path",
    "allow-open-in-file-manager",
    "allow-watch-file",
    "allow-unwatch-file",
    "allow-initial-file",
    "allow-notes-dir",
    "allow-search-notes",
    "allow-rename-note",
    "allow-trash-note",
    "allow-update-info",
    "allow-update-check",
    "allow-update-download",
    "allow-update-install"
  ]
}
