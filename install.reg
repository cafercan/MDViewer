Windows Registry Editor Version 5.00

; Bind .md to MDFlow.Viewer
[HKEY_CURRENT_USER\Software\Classes\.md]
@="MDFlow.Viewer"

[HKEY_CURRENT_USER\Software\Classes\.md\OpenWithProgids]
"MDFlow.Viewer"=""

; Bind .markdown to MDFlow.Viewer
[HKEY_CURRENT_USER\Software\Classes\.markdown]
@="MDFlow.Viewer"

[HKEY_CURRENT_USER\Software\Classes\.markdown\OpenWithProgids]
"MDFlow.Viewer"=""

; MDFlow.Viewer program definition
[HKEY_CURRENT_USER\Software\Classes\MDFlow.Viewer]
@="Markdown Belgesi"

[HKEY_CURRENT_USER\Software\Classes\MDFlow.Viewer\DefaultIcon]
@="\"d:\\Workspaces\\VSCode\\MDViewer\\public\\mdflow.ico\""

[HKEY_CURRENT_USER\Software\Classes\MDFlow.Viewer\shell]

[HKEY_CURRENT_USER\Software\Classes\MDFlow.Viewer\shell\open]
@="MD Flow Viewer ile Ac"
"Icon"="d:\\Workspaces\\VSCode\\MDViewer\\public\\mdflow.ico"

[HKEY_CURRENT_USER\Software\Classes\MDFlow.Viewer\shell\open\command]
@="\"d:\\Workspaces\\VSCode\\MDViewer\\MDFlowViewer.exe\" \"%1\""

; Remove old launcher app registrations
[-HKEY_CURRENT_USER\Software\Classes\Applications\run.bat]
[-HKEY_CURRENT_USER\Software\Classes\Applications\launch-hidden.vbs]

; Register EXE in Open With
[HKEY_CURRENT_USER\Software\Classes\Applications\MDFlowViewer.exe]
@="MD Flow Viewer"

[HKEY_CURRENT_USER\Software\Classes\Applications\MDFlowViewer.exe\DefaultIcon]
@="\"d:\\Workspaces\\VSCode\\MDViewer\\public\\mdflow.ico\""

[HKEY_CURRENT_USER\Software\Classes\Applications\MDFlowViewer.exe\shell]

[HKEY_CURRENT_USER\Software\Classes\Applications\MDFlowViewer.exe\shell\open]
@="MD Flow Viewer ile Ac"
"Icon"="d:\\Workspaces\\VSCode\\MDViewer\\public\\mdflow.ico"

[HKEY_CURRENT_USER\Software\Classes\Applications\MDFlowViewer.exe\shell\open\command]
@="\"d:\\Workspaces\\VSCode\\MDViewer\\MDFlowViewer.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\Applications\MDFlowViewer.exe\SupportedTypes]
".md"=""
".markdown"=""

; Context menu entries
[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.md\shell\OpenWithMDFlow]
@="MD Flow Viewer ile Ac"
"Icon"="d:\\Workspaces\\VSCode\\MDViewer\\public\\mdflow.ico"

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.md\shell\OpenWithMDFlow\command]
@="\"d:\\Workspaces\\VSCode\\MDViewer\\MDFlowViewer.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.markdown\shell\OpenWithMDFlow]
@="MD Flow Viewer ile Ac"
"Icon"="d:\\Workspaces\\VSCode\\MDViewer\\public\\mdflow.ico"

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.markdown\shell\OpenWithMDFlow\command]
@="\"d:\\Workspaces\\VSCode\\MDViewer\\MDFlowViewer.exe\" \"%1\""
